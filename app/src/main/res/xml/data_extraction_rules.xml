<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">
    <!--
      Regras para Android 12 (API 31) ou superior.
      Exclui o banco de dados Room e as preferências do DataStore de:
      - backup em nuvem (android:allowBackup ja esta falso)
      - transferencia direta entre dispositivos (device-to-device migration)
      Observacao: regras reduzem a exposicao, nao garantem protecao contra
      dispositivos comprometidos, root ou acesso fisico indevido.
    -->
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
